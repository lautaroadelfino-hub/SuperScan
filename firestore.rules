rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar autenticación
    function isAuth() {
      return request.auth != null;
    }

    // Colección: productos
    match /productos/{document=**} {
      allow read: if isAuth();
      allow write: if false;
    }

    // catalogo_meta/precios: SOLO agregados (cuántos productos con precio,
    // cuántos precios, de qué fecha). Lectura pública porque la pantalla de
    // ingreso los muestra, y ahí todavía no hay sesión. No hay nada de nadie
    // acá: son totales del catálogo, los mismos que se publicitan.
    match /catalogo_meta/precios {
      allow read: if true;
      allow write: if false;
    }

    // Colección: catalogo_meta (estructura del catálogo: categorías,
    // subcategorías y marcas; la genera el pipeline de carga, no la app)
    match /catalogo_meta/{document=**} {
      allow read: if isAuth();
      // La estructura se sube con scripts/generar_estructura.py, que necesita
      // una excepción temporal acá (ver el docstring del script).
      allow write: if false;
    }

    // Colección: productos_usuarios (catálogo colaborativo: los documentos
    // no guardan userId, cualquier usuario autenticado puede aportar/corregir)
    match /productos_usuarios/{document=**} {
      allow read: if isAuth();
      allow create, update: if isAuth();
      allow delete: if false;
    }

    // Colección: usuarios
    match /usuarios/{uid} {
      allow read, write: if isAuth() && request.auth.uid == uid;
    }

    // Colección: tickets
    match /tickets/{ticketId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Colección: observaciones_precios
    // Estructura: { ean, descripcionCruda, comercio, cadena, precio, fecha, fuente, uid }.
    // `cadena` es el id del map `precios` (vea, carrefour...) y `comercio` su
    // nombre legible: el Modo Súper pregunta en qué súper está el usuario.
    // La lectura es abierta a usuarios autenticados: el historial de precios de
    // un producto se construye con las observaciones de TODOS los usuarios.
    // Escribir/borrar solo lo propio (validado contra el campo uid).
    match /observaciones_precios/{obsId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // Colección: listas compartidas (en código figura como shared_lists)
    // El array members guarda EMAILS (no UIDs), por eso se valida contra
    // request.auth.token.email.
    match /shared_lists/{listId} {
      allow read, update, delete: if isAuth() && request.auth.token.email in resource.data.members;
      allow create: if isAuth() && request.auth.token.email in request.resource.data.members;

      // Subcolección de ítems de la lista
      match /items/{itemId} {
        allow read, write: if isAuth() && request.auth.token.email in get(/databases/$(database)/documents/shared_lists/$(listId)).data.members;
      }
    }
  }
}
